//@version=6
indicator(
     "Finsec Structure Matcher",
     "Finsec Matcher",
     overlay = true,
     max_bars_back = 500,
     max_boxes_count = 100,
     max_lines_count = 100,
     max_labels_count = 100,
     calc_bars_count = 500)

const int MINIMUM_FORMATION_CANDLES = 5
const int SNAPSHOT_CAPACITY = 25
const float FINSEC_LENGTH_GATE = 0.70
const string MATCHING_GROUP = "Matching"
const string FORMATION_GROUP = "Current formation"
const string ANNOTATION_GROUP = "Current annotations"
const string SNAPSHOT_GROUP = "Finsec snapshots"

int searchCandlesInput = input.int(
     200,
     "Search candles",
     minval = MINIMUM_FORMATION_CANDLES,
     maxval = 500,
     group = MATCHING_GROUP,
     tooltip = "Maximum candidate length ending at the current candle.")
int scanStepInput = input.int(
     2,
     "Scan step",
     minval = 1,
     maxval = 20,
     group = MATCHING_GROUP,
     tooltip = "1 checks every candidate length. Higher values reduce TradingView runtime.")
int requiredExamplesInput = input.int(
     0,
     "Required examples",
     minval = 0,
     maxval = SNAPSHOT_CAPACITY,
     group = MATCHING_GROUP,
     tooltip = "0 uses a strict majority of the loaded examples.")
float structureGateInput = input.float(
     85.0,
     "Structure gate",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = MATCHING_GROUP)
float lengthGateInput = input.float(
     70.0,
     "Length gate",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = MATCHING_GROUP)
float sizeGateInput = input.float(
     70.0,
     "Size gate",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = MATCHING_GROUP)

bool showFormationInput = input.bool(true, "Show formation", group = FORMATION_GROUP)
color formingColorInput = input.color(color.orange, "Forming colour", group = FORMATION_GROUP)
color confirmedColorInput = input.color(color.lime, "Confirmed colour", group = FORMATION_GROUP)
int formationTransparencyInput = input.int(
     88,
     "Fill transparency",
     minval = 0,
     maxval = 100,
     group = FORMATION_GROUP)
bool showFormationDetailsInput = input.bool(true, "Show formation details", group = FORMATION_GROUP)

bool showAnnotationsInput = input.bool(true, "Show annotations", group = ANNOTATION_GROUP)
color structureColorInput = input.color(color.aqua, "Structure colour", group = ANNOTATION_GROUP)
color entryColorInput = input.color(color.blue, "Entry colour", group = ANNOTATION_GROUP)
color exitColorInput = input.color(color.gray, "Exit colour", group = ANNOTATION_GROUP)
color stopLossColorInput = input.color(color.red, "Stop-loss colour", group = ANNOTATION_GROUP)
color takeProfitColorInput = input.color(color.green, "Take-profit colour", group = ANNOTATION_GROUP)
int annotationTransparencyInput = input.int(
     82,
     "Fill transparency",
     minval = 0,
     maxval = 100,
     group = ANNOTATION_GROUP)

string snapshot001Input = input.text_area("", "Finsec snapshot 001", group = SNAPSHOT_GROUP)
string snapshot002Input = input.text_area("", "Finsec snapshot 002", group = SNAPSHOT_GROUP)
string snapshot003Input = input.text_area("", "Finsec snapshot 003", group = SNAPSHOT_GROUP)
string snapshot004Input = input.text_area("", "Finsec snapshot 004", group = SNAPSHOT_GROUP)
string snapshot005Input = input.text_area("", "Finsec snapshot 005", group = SNAPSHOT_GROUP)
string snapshot006Input = input.text_area("", "Finsec snapshot 006", group = SNAPSHOT_GROUP)
string snapshot007Input = input.text_area("", "Finsec snapshot 007", group = SNAPSHOT_GROUP)
string snapshot008Input = input.text_area("", "Finsec snapshot 008", group = SNAPSHOT_GROUP)
string snapshot009Input = input.text_area("", "Finsec snapshot 009", group = SNAPSHOT_GROUP)
string snapshot010Input = input.text_area("", "Finsec snapshot 010", group = SNAPSHOT_GROUP)
string snapshot011Input = input.text_area("", "Finsec snapshot 011", group = SNAPSHOT_GROUP)
string snapshot012Input = input.text_area("", "Finsec snapshot 012", group = SNAPSHOT_GROUP)
string snapshot013Input = input.text_area("", "Finsec snapshot 013", group = SNAPSHOT_GROUP)
string snapshot014Input = input.text_area("", "Finsec snapshot 014", group = SNAPSHOT_GROUP)
string snapshot015Input = input.text_area("", "Finsec snapshot 015", group = SNAPSHOT_GROUP)
string snapshot016Input = input.text_area("", "Finsec snapshot 016", group = SNAPSHOT_GROUP)
string snapshot017Input = input.text_area("", "Finsec snapshot 017", group = SNAPSHOT_GROUP)
string snapshot018Input = input.text_area("", "Finsec snapshot 018", group = SNAPSHOT_GROUP)
string snapshot019Input = input.text_area("", "Finsec snapshot 019", group = SNAPSHOT_GROUP)
string snapshot020Input = input.text_area("", "Finsec snapshot 020", group = SNAPSHOT_GROUP)
string snapshot021Input = input.text_area("", "Finsec snapshot 021", group = SNAPSHOT_GROUP)
string snapshot022Input = input.text_area("", "Finsec snapshot 022", group = SNAPSHOT_GROUP)
string snapshot023Input = input.text_area("", "Finsec snapshot 023", group = SNAPSHOT_GROUP)
